# ==========================================================
#  SpaceHQ — environment configuration
#  KEEP THIS FILE SECRET. Copy to .env and never commit .env.
# ==========================================================

# Runtime
NODE_ENV=production
PORT=3000

# --- Authentication ---
# Username used to sign in (an email works fine)
AUTH_USER=you@spacehq.ca

# bcrypt hash of the password (NOT the plaintext password).
# Generate it (along with SESSION_SECRET and DATA_ENC_KEY) with:
#   npm run hash "your-password"
# then paste the printed values below.
AUTH_PASS_HASH=  # run: npm run hash "your-password"

# Secret used to sign session cookies. Keep it long and random.
# Regenerate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=  # printed by `npm run hash`

# 32-byte (64 hex) key used to AES-256-GCM encrypt secrets at rest (e.g. the 2FA
# TOTP secret, and anything your future modules encrypt). Keep it stable.
# Regenerate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENC_KEY=  # printed by `npm run hash`

# --- Two-factor authentication (optional) ---
# 2FA is off until you enable it via the /api/2fa endpoints (once you build a
# Settings UI). Break-glass: if you lose your authenticator AND recovery codes,
# set DISABLE_2FA=1 and restart to sign in and reset it.
# DISABLE_2FA=

# --- Storage (optional) ---
# By default, storage uses local files under data/ (JSON blobs) plus SQLite
# (data/spacehq.db) — no external database required. To use MongoDB instead,
# set MONGODB_URI (and run `npm install` so the mongodb driver is present).
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
#   MONGODB_DB=spacehq
# MONGODB_URI=
# MONGODB_DB=spacehq
